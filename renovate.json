{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "maintenance"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Merge non-major updates straight into main once the branch checks pass, without opening a PR",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}

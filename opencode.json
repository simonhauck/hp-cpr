{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dart": {
        "type": "local",
        "command": [
          "nix",
          "develop",
          "--command",
          "dart",
          "mcp-server",
          "--force-roots-fallback",
          "--enable",
          "cli",
          "--enable",
          "flutter_app_lifecycle"
        ],
        "timeout": {
          "startup": 300000
        }
      }
    }
  }
}

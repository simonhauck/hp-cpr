{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "dart": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server",
          "--force-roots-fallback",
          "--enable",
          "cli",
          "--enable",
          "flutter_app_lifecycle"
        ],
        "timeout": {
          "startup": 30000
        }
      }
    }
  }
}
